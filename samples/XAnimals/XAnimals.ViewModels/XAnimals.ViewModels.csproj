<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XAnimals.ViewModels of the Routeables repository (samples/Bases/XAnimals.ViewModels): The view models of the samples.
    Its sources are compiled here against the Routeables package that Routeables.SignalR depends on, not with the projects of Routeables
    (they would bring a second copy of each Routeables assembly). RouteablesRoot says where Routeables is checked out; its revision must match
    the package (ROUTEABLES_REF in the CI).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The generator of routes registers the view models of this assembly, as in Routeables (see Directory.Build.targets). -->
    <UseRouteablesGenerator>true</UseRouteablesGenerator>
    <XAnimalsSources>$(RouteablesRoot)samples\Bases\XAnimals.ViewModels\</XAnimalsSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(XAnimalsSources)**\*.cs" Exclude="$(XAnimalsSources)bin\**;$(XAnimalsSources)obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Routeables" Version="$(RouteablesPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XAnimals.Common\XAnimals.Common.csproj" />
    <ProjectReference Include="..\XAnimals.Birds\XAnimals.Birds.csproj" />
  </ItemGroup>

</Project>
