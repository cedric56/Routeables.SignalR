<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <VersionPrefix>2.0.0</VersionPrefix>
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <!-- Where the Routeables repository is checked out: next to this one by default. The projects reference its sources. -->
    <RouteablesRoot Condition="'$(RouteablesRoot)' == ''">$(MSBuildThisFileDirectory)..\Routeables\</RouteablesRoot>
    <!--
      As a full path without "..": the projects of Routeables reference one another by their own relative paths, and NuGet in Visual Studio must see
      one project under one path. "Routeables.SignalR\..\Routeables\samples\..." and "Routeables\samples\..." were two projects to it (NU1105).
    -->
    <RouteablesRoot>$([MSBuild]::NormalizeDirectory('$(RouteablesRoot)'))</RouteablesRoot>
    <!-- Where the Essentieables repository is checked out, for Essentieables.Facades (Routeables.SignalR.Essentials): next to this one too. -->
    <EssentieablesRoot Condition="'$(EssentieablesRoot)' == ''">$(MSBuildThisFileDirectory)..\Essentieables\</EssentieablesRoot>
    <EssentieablesRoot>$([MSBuild]::NormalizeDirectory('$(EssentieablesRoot)'))</EssentieablesRoot>
  </PropertyGroup>

  <PropertyGroup>
    <Copyright>Copyright (c) 2026 Cédric Boutin</Copyright>
    <PackageProjectUrl>https://github.com/cedric56/Routeables.SignalR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cedric56/Routeables.SignalR.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>routing;navigation;mvvm;viewmodel;signalr;angular;vue</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Routeables.SignalR'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735;CS0419</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
