<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Description>Serves Routeables view models to a browser front end (Angular, Vue or any JavaScript client) over SignalR.</Description>
    <!-- The view models are read by reflection: say it to an application that trims or compiles ahead of time. -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The Routeables Remote Protocol, served by ReplicationHub: a package of its own (no dependency), at the version of this one. -->
  <ItemGroup>
    <ProjectReference Include="..\Routeables.Remote\Routeables.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.SignalR.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Routeables" Version="$(RouteablesPackageVersion)" />
  </ItemGroup>

</Project>
