<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Description>Serves Routeables view models to a browser front end (Angular, Vue or any JavaScript client) over SignalR.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RouteablesRoot)src\Routeables.Core\Routeables.Core.csproj" />
    <ProjectReference Include="$(RouteablesRoot)src\Routeables.Abstraction\Routeables.Abstraction.csproj" />
    <ProjectReference Include="$(RouteablesRoot)src\Routeables.Segments\Routeables.Segments.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.SignalR.Test" />
  </ItemGroup>

</Project>
