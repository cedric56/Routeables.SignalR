{
  "name": "@routeables/client",
  "version": "2.0.0",
  "description": "Client of Routeables.SignalR: shows the view models of a Routeables server in Angular, Vue or any JavaScript front end.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedric56/Routeables.SignalR.git",
    "directory": "clients/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/client.test.js dist-test/test/remote.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@microsoft/signalr": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@microsoft/signalr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  }
}
